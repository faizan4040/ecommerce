# Copy to socket-server/.env (or set these in the Render dashboard)

# Same MongoDB database as the Next.js app
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/DB_NAME

# MUST be the same value as SECRET_KEY in the Next.js app (.env.local / Vercel)
SECRET_KEY=change-me

# Website URL(s) allowed to connect, comma separated (no trailing slash)
CLIENT_ORIGINS=http://localhost:3000,https://your-store.com

# Render sets PORT automatically – for local dev the default is 4000
# PORT=4000
